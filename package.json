{
  "name": "stuntdouble-docs",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "node scripts/fetch-sources.mjs && node scripts/generate.mjs && next build",
    "start": "next start",
    "type-check": "next typegen && tsc --noEmit",
    "test": "node --test src/**/*.test.ts scripts/*.test.mjs"
  },
  "dependencies": {
    "@next/third-parties": "16.3.8",
    "fumadocs-core": "^16.16.1",
    "fumadocs-mdx": "^15.4.6",
    "fumadocs-ui": "^16.16.1",
    "github-slugger": "^2.0.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
